<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required for biometric authentication (Fingerprint / Face Unlock / PIN) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <!-- Required for any real network call (donor-auth/donor-portal API calls
         added in api_service.dart) — the app never made a real request
         before that, so this was never needed until now. Without it, every
         http.* call fails with a generic connection error, which is exactly
         what the OTP screen was showing. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    
    <!-- Required for image_picker plugin to access the camera. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Android 13+ (API 33) requires this to be granted explicitly at
         runtime before any notification — including FCM push — can show.
         Requested from Dart via firebase_messaging's requestPermission()
         (see notif_service.dart). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- "Use my location" (Settings > alert radius) — requested at runtime
         through geolocator when the donor turns the toggle on. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Saving the Digital Health Card to the gallery (gal). Only needed on
         Android 9 and below; newer versions save without a permission. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <application
        android:label="resq"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon"
        android:requestLegacyExternalStorage="true">
        <activity
            android:name="com.example.resq.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"
                />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Channel a background/terminated-state FCM notification posts to
             by default — must match the channel created in push_service.dart
             so Android doesn't fall back to its own generic "Miscellaneous"
             channel (which the donor could mute without realizing it also
             mutes blood-request alerts). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="resq_alerts_channel" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/launcher_icon" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>